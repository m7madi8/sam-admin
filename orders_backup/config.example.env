# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى Git.

# ========== قاعدة البيانات ==========
# النوع: mysql أو postgresql
DB_TYPE=mysql

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=كلمة_السر
DB_NAME=اسم_قاعدة_البيانات

# PostgreSQL (إذا استخدمته)
# DB_TYPE=postgresql
# DB_PORT=5432

# اسم جدول الطلبات وعمود تاريخ الإنشاء
ORDERS_TABLE=orders
CREATED_AT_COLUMN=created_at

# ========== Google Drive ==========
# معرّف مجلد Drive (من رابط المجلد: .../folders/هذا_المعرّف)
DRIVE_FOLDER_ID=

# مسار ملف credentials من Google Cloud Console (نسبياً لمجلد السكريبت أو مطلق)
CREDENTIALS_PATH=credentials.json
